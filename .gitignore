# 本地安全清理工具与隔离的 Git 历史副本。
.security-cleanup/

# Python 虚拟环境、缓存和构建产物。
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# 知识库运行数据由 Docker 持久化卷保存；忽略旧版及手动创建的本地数据。
/volumes/
/src/JLU_agent/repo/chroma_db/
/src/JLU_agent/repo/index_db/
/src/JLU_agent/repo/md5.txt

# 短期记忆数据库及 SQLite 的日志文件。
/src/JLU_agent/repo/short-term_memory/*.db
/src/JLU_agent/repo/short-term_memory/*.db-*

# 编辑器配置。
.idea/

# 本地 Ragas 实验、逐题日志和报告。
/evaluation_runs/

# 测试与评估代码保留本地，不进入发布提交。
/tests/
/src/JLU_agent/evaluation/
/scripts/build_eval_dataset.py
/docs/rag_evaluation.md
/docs/rag_resume_summary.md
.coverage
.coverage.*
htmlcov/
coverage.xml

# 本地凭据文件；仅保留空值示例。
.envrc
*.pem
*.key
credentials.json
secrets.json
secrets.yaml
secrets.yml
