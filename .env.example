# 在本地 .env 中填写 DeepSeek、Tavily 和 DashScope API 密钥。
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
DASHSCOPE_API_KEY=

# Milvus Standalone；远程服务可覆盖 URI 和 Token。
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION_NAME=jlu_knowledge

# Ragas 使用 DashScope Qwen 评判，复用上面的 DASHSCOPE_API_KEY。
# validate 和 prepare 不需要评判配置；URL 和密钥的地域必须一致。
EVAL_JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVAL_JUDGE_MODEL=qwen-plus
# 评估库名称自动添加资料/切分配置摘要，不使用应用知识库。
EVAL_COLLECTION_PREFIX=jlu_eval
